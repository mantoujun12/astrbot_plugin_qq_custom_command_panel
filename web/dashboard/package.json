{
  "name": "dashboard",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml",
    "test:codecov": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11",
    "vuetify": "^4.2.4"
  }
}
